# ==========================================
# KL Trends - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Sensitive Data & Environment Files
# ------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.*.example

# Private Keys, Certificates, & Keystores
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pubxml
*.publishsettings

# API Keys, Cloud & Third-party Credentials
credentials.json
client_secret*.json
google-services.json
GoogleService-Info.plist
*.mobileprovision
auth-token*.json
secrets.*

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
.pnp
.pnp.js
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# Build Outputs & Compiled Code
# ------------------------------------------
dist/
build/
out/
bin/
obj/
*.tsbuildinfo

# ------------------------------------------
# Mobile (Expo & React Native)
# ------------------------------------------
.expo/
.expo-alert-check/
.expo-shared/
web-build/
*.apk
*.aab
*.ipa

# Native Android / iOS Build Outputs (if generated)
android/.gradle/
android/app/build/
android/build/
android/local.properties
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/*.xcuserdata

# Metro Bundler Cache
.metro-health-check*

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
dump.rdb

# ------------------------------------------
# Logs & Process Files
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------
# Temporary & Cache Files
# ------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.swp
*~

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log
