# ==========================================
# KL Trends Mobile - Git Ignore
# ==========================================

# ------------------------------------------
# Environment & Sensitive Files
# ------------------------------------------

.env
.env.*
*.env
!.env.example
!.env.*.example

# Private Keys & Certificates
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore

# ------------------------------------------
# Dependencies
# ------------------------------------------

node_modules/
.npm/

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# Expo & React Native
# ------------------------------------------

.expo/
.expo-alert-check/
.expo-shared/
web-build/

# Build Files
*.apk
*.aab
*.ipa

# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties

# iOS
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/*.xcuserdata

# ------------------------------------------
# Metro Cache
# ------------------------------------------

.metro-health-check*

# ------------------------------------------
# Build Outputs
# ------------------------------------------

dist/
build/
*.tsbuildinfo

# ------------------------------------------
# Logs
# ------------------------------------------

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Temporary Files
# ------------------------------------------

tmp/
temp/
*.tmp
*.temp
*.swp
*~

# ------------------------------------------
# Operating System
# ------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDE
# ------------------------------------------

.idea/
*.sublime-project
*.sublime-workspace

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json