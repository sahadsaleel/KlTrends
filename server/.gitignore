# ==========================================
# KL Trends Server - Git Ignore
# ==========================================

# ------------------------------------------
# Environment & Sensitive Files
# ------------------------------------------

.env
.env.*
*.env
!.env.example
!.env.*.example

# ------------------------------------------
# Private Keys & Certificates
# ------------------------------------------

*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore

id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ------------------------------------------
# API Keys & Credentials
# ------------------------------------------

credentials.json
client_secret*.json
auth-token*.json
secrets.*

# ------------------------------------------
# Dependencies
# ------------------------------------------

node_modules/
.npm/

.pnp
.pnp.js

.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# Build Outputs
# ------------------------------------------

dist/
build/
out/
bin/
obj/

*.tsbuildinfo

# ------------------------------------------
# Database Files
# ------------------------------------------

*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
dump.rdb

# ------------------------------------------
# Logs
# ------------------------------------------

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

*.pid
*.pid.lock

# ------------------------------------------
# Testing
# ------------------------------------------

coverage/
.nyc_output/
*.lcov

# ------------------------------------------
# Temporary Files
# ------------------------------------------

tmp/
temp/
*.tmp
*.temp
*.swp
*~

# ------------------------------------------
# Operating System
# ------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDE
# ------------------------------------------

.idea/
*.sublime-project
*.sublime-workspace

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json