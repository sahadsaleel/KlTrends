PORT=5000
NODE_ENV=production
# Use a long, random secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=AdminKlTrend
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@kltrends.example

# MySQL database configuration (DB_* or Railway MYSQL* / DATABASE_URL / MYSQL_URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=kltrends
# Alternatively for Railway:
# MYSQL_URL=mysql://root:...@...
# DATABASE_URL=mysql://root:...@...

# Cloudinary image storage for attendance selfies and profile avatars
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=kltrends/attendance_selfies

# SMTP for registration and password-reset verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM="KL Trends" <notifications@example.com>

# CORS allowed origins (leave empty to allow mobile apps and web, or specify comma-separated domains)
ALLOWED_ORIGINS=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=10
