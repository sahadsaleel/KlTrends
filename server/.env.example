PORT=5000
NODE_ENV=production
# Use a long, random secret. Never use the old sample value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Comma-separated, approved addresses that may create an administrator account.
ADMIN_EMAIL_ALLOWLIST=owner@your-company.example

# MySQL database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=kltrends

# SMTP is required for registration and password-reset verification emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM="KL Trends" <notifications@example.com>
